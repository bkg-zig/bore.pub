# Caddyfile - TLS for *.eysho.info in front of bore-router.js
#
#   /etc/caddy/Caddyfile
#
# Caddy gets one certificate per subdomain on demand, and asks the router
# whether the name is ours before requesting a certificate (on_demand_tls).
# No DNS provider plugin or wildcard certificate is needed, as long as
# *.eysho.info points at this host and port 80/443 are reachable.

{
	on_demand_tls {
		ask http://127.0.0.1:8080/ask
	}
}

https://*.eysho.info, https://eysho.info {
	tls {
		on_demand
	}

	encode zstd gzip

	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-Proto {scheme}
		# Pinokio's terminal and app UIs use WebSockets heavily
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}
